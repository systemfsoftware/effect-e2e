{
  "name": "@systemfsoftware/effect-e2e-web",
  "license": "Apache-2.0",
  "version": "1.1.2",
  "author": "Ryan Lee <drdgvhbh@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/systemfsoftware/effect-e2e.git",
    "directory": "packages/effect-e2e-web"
  },
  "homepage": "https://github.com/systemfsoftware/effect-e2e/tree/main/packages/effect-e2e-web#readme",
  "bugs": "https://github.com/systemfsoftware/effect-e2e/issues",
  "description": "The web engine for @systemfsoftware/effect-e2e: the Engine service over a Playwright browser.",
  "keywords": [
    "effect",
    "effect-ts",
    "e2e",
    "end-to-end",
    "testing",
    "playwright",
    "browser"
  ],
  "type": "module",
  "exports": {
    ".": {
      "@systemfsoftware/source": "./src/mod.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rimraf dist",
    "build": "tsdown -l warn && pnpm api:check",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "api:check": "api-extractor-quiet run",
    "api:update": "api-extractor run --local",
    "lint": "f=${OXLINT_FORMAT:-${AGENT:+agent}}; oxlint . --format=${f:-default}",
    "attw": "attw --pack ."
  },
  "dependencies": {
    "@systemfsoftware/effect-e2e": "workspace:^"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "catalog:",
    "@systemfsoftware/arethetypeswrong-cli": "catalog:",
    "@systemfsoftware/effect-gherkin-spec": "^8.0.0",
    "@systemfsoftware/effect-schema-law": "^6.1.0",
    "@systemfsoftware/effect-schema-vite": "^3.1.1",
    "@systemfsoftware/oxlint-config-recommended": "^5.0.0",
    "@systemfsoftware/tsconfig": "^2.0.2",
    "@systemfsoftware/tsdown-config": "^0.1.1",
    "@systemfsoftware/vitest": "^3.0.0",
    "@systemfsoftware/vitest-config": "^0.1.1",
    "@types/node": "catalog:",
    "effect": "catalog:",
    "oxlint": "catalog:oxlint",
    "playwright": "catalog:",
    "rimraf": "catalog:",
    "tsdown": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "effect": "catalog:peers",
    "playwright": "catalog:"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "./package.json": "./package.json"
    },
    "provenance": true
  }
}
